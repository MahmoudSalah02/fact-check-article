# Copy to .env.local (gitignored) and fill in. Never commit real secrets.

# Local default: deterministic fakes, no credentials required.
DATA_BACKEND=fake
ANALYSIS_PROVIDER=fixture

# Supabase persistence. Values come from `pnpm supabase status` locally or the
# hosted project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Live analysis. Required only when ANALYSIS_PROVIDER=openai (also needs
# DATA_BACKEND=supabase). OPENAI_MODEL must support web_search + structured
# outputs, e.g. gpt-5.6-luna. OPENAI_WEBHOOK_SECRET is optional: GET
# reconciliation completes runs by polling; only the webhook route needs it.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_WEBHOOK_SECRET=
